{
  "$schema": "../launcher-config.v1.schema.json",
  "schemaVersion": 1,
  "revision": 1,
  "grid": {
    "columns": 4,
    "rows": 12
  },
  "pages": [
    {
      "id": "home",
      "title": "Home",
      "items": [
        {
          "id": "a-settings",
          "type": "app",
          "package": "com.android.settings",
          "x": 0,
          "y": 0
        },
        {
          "id": "s-chrome-incognito",
          "type": "shortcut",
          "package": "com.android.chrome",
          "shortcutId": "incognito-tab",
          "label": "Incognito",
          "x": 1,
          "y": 0
        },
        {
          "id": "f-tools",
          "type": "folder",
          "label": "Tools",
          "items": [
            {
              "id": "a-calc",
              "type": "app",
              "package": "com.google.android.calculator"
            },
            {
              "id": "a-clock",
              "type": "app",
              "package": "com.google.android.deskclock",
              "activity": "com.android.deskclock.DeskClock"
            }
          ],
          "x": 2,
          "y": 0
        }
      ]
    }
  ],
  "dock": [
    {
      "id": "a-dialer",
      "type": "app",
      "package": "com.google.android.dialer"
    },
    {
      "id": "a-camera",
      "type": "app",
      "package": "com.android.camera2"
    }
  ],
  "drawer": {
    "sort": "label",
    "hidden": [],
    "rules": [
      {
        "id": "r-games",
        "group": "Games",
        "match": {
          "category": "game"
        }
      }
    ]
  },
  "elements": [
    {
      "id": "w-usage",
      "type": "card",
      "requires": 6,
      "page": "home",
      "x": 0,
      "y": 8,
      "w": 4,
      "h": 3,
      "title": "Agent usage",
      "author": "agent",
      "header": false,
      "surface": {
        "color": "#0F6E6E"
      },
      "layers": [
        {
          "kind": "picture",
          "src": "sticker-{data:state}.webp",
          "default": "sticker-idle.webp",
          "fit": "fixed",
          "width": 0.4,
          "align": "bottom",
          "offset": {
            "x": 0,
            "y": 0.15
          },
          "overflow": true,
          "opacity": 0.8,
          "scrim": "none"
        },
        {
          "kind": "content"
        }
      ],
      "summary": "Agent usage, {data:state}. Context {data:ctx|round} percent",
      "capabilities": [
        {
          "kind": "data.file"
        },
        {
          "kind": "ui.reload"
        }
      ],
      "data": {
        "staleAfter": "PT15M"
      },
      "layouts": {
        "4x3": [
          {
            "type": "text",
            "role": "caption",
            "font": "mono",
            "align": "end",
            "text": "up {data:started_at|since}"
          },
          {
            "type": "progress",
            "label": "ctx",
            "value": "{data:ctx}",
            "max": 100,
            "style": "ticks",
            "by": "position",
            "thresholds": [
              {
                "from": 0,
                "tone": "accent"
              },
              {
                "from": 75,
                "tone": "warn"
              }
            ]
          },
          {
            "type": "progress",
            "label": "5h",
            "value": "{data:five_hour}",
            "max": 100,
            "style": "ticks",
            "by": "position",
            "thresholds": [
              {
                "from": 0,
                "tone": "accent"
              },
              {
                "from": 75,
                "tone": "warn"
              }
            ]
          },
          {
            "type": "progress",
            "label": "7d",
            "value": "{data:seven_day}",
            "max": 100,
            "style": "ticks",
            "by": "position",
            "thresholds": [
              {
                "from": 0,
                "tone": "accent"
              },
              {
                "from": 75,
                "tone": "warn"
              }
            ]
          },
          {
            "type": "text",
            "role": "caption",
            "font": "mono",
            "align": "end",
            "text": "status: {data:state|default:unknown}"
          }
        ]
      }
    }
  ]
}
