{
  "$schema": "../launcher-config.v1.schema.json",
  "schemaVersion": 1,
  "revision": 1,
  "grid": {
    "columns": 4,
    "rows": 12
  },
  "pages": [
    {
      "id": "home",
      "title": "Home",
      "items": [
        {
          "id": "a-settings",
          "type": "app",
          "package": "com.android.settings",
          "x": 0,
          "y": 0
        },
        {
          "id": "s-chrome-incognito",
          "type": "shortcut",
          "package": "com.android.chrome",
          "shortcutId": "incognito-tab",
          "label": "Incognito",
          "x": 1,
          "y": 0
        },
        {
          "id": "f-tools",
          "type": "folder",
          "label": "Tools",
          "items": [
            {
              "id": "a-calc",
              "type": "app",
              "package": "com.google.android.calculator"
            },
            {
              "id": "a-clock",
              "type": "app",
              "package": "com.google.android.deskclock",
              "activity": "com.android.deskclock.DeskClock"
            }
          ],
          "x": 2,
          "y": 0
        }
      ]
    }
  ],
  "dock": [
    {
      "id": "a-dialer",
      "type": "app",
      "package": "com.google.android.dialer"
    },
    {
      "id": "a-camera",
      "type": "app",
      "package": "com.android.camera2"
    }
  ],
  "drawer": {
    "sort": "label",
    "hidden": [],
    "rules": [
      {
        "id": "r-games",
        "group": "Games",
        "match": {
          "category": "game"
        }
      }
    ]
  },
  "elements": [
    {
      "id": "w-status",
      "type": "card",
      "requires": 6,
      "page": "home",
      "x": 0,
      "y": 2,
      "w": 4,
      "h": 5,
      "minSpan": {
        "w": 2,
        "h": 2
      },
      "title": "Example Co",
      "author": "agent",
      "source": "https://status.example.com",
      "capabilities": [
        {
          "kind": "data.file"
        },
        {
          "kind": "ui.reload"
        },
        {
          "kind": "ui.openUrl"
        }
      ],
      "data": {
        "staleAfter": "PT30M"
      },
      "layouts": {
        "2x2": [
          {
            "type": "metric",
            "label": "Monitors",
            "value": "{data:monitors.summary}",
            "status": "{data:monitors.status}"
          }
        ],
        "4x5": [
          {
            "type": "tile",
            "tap": {
              "kind": "ui.openUrl",
              "url": "{data:blog.url}"
            },
            "children": [
              {
                "type": "text",
                "role": "caption",
                "text": "Latest on status.example.com"
              },
              {
                "type": "text",
                "role": "title",
                "text": "{data:blog.title}",
                "maxLines": 2
              },
              {
                "type": "text",
                "role": "body",
                "text": "{data:blog.excerpt}",
                "maxLines": 1
              }
            ]
          },
          {
            "type": "row",
            "children": [
              {
                "type": "metric",
                "label": "Site A",
                "value": "{data:site_a.value}",
                "status": "{data:site_a.status}",
                "weight": 1
              },
              {
                "type": "metric",
                "label": "Site B",
                "value": "{data:site_b.value}",
                "status": "{data:site_b.status}",
                "weight": 1,
                "priority": 4
              },
              {
                "type": "metric",
                "label": "Monitors",
                "value": "{data:monitors.summary}",
                "status": "{data:monitors.status}",
                "weight": 1
              }
            ]
          },
          {
            "type": "tile",
            "children": [
              {
                "type": "text",
                "role": "caption",
                "text": "Unhealthy monitors"
              },
              {
                "type": "row",
                "children": [
                  {
                    "type": "text",
                    "text": "{data:unhealthy.text}",
                    "status": "{data:unhealthy.status}",
                    "weight": 1
                  },
                  {
                    "type": "text",
                    "text": "{data:monitors.summary}",
                    "align": "end"
                  }
                ]
              }
            ]
          }
        ]
      }
    }
  ]
}
